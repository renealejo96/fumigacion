# ==============================================================================
# AgroFumigación - Variables de Entorno para Producción / Docker
# ==============================================================================

# Configuración de Flask
FLASK_APP=run.py
FLASK_ENV=production
SECRET_KEY=cambiar_por_una_clave_segura_aleatoria_2026

# Credenciales de Base de Datos PostgreSQL
DB_USER=fumigacion_user
DB_PASSWORD=fumigacion_secure_pass_2026
DB_NAME=fumigacion_db

# ==============================================================================
# PUERTOS PERSONALIZADOS (NO USAN PUERTOS POR DEFECTO 80, 5000, 5432)
# ==============================================================================
# Puerto para la aplicación web en el VPS (Host)
APP_PORT=8095

# Puerto para PostgreSQL en el VPS (Host)
DB_PORT=5495

# Clave inicial del usuario administrador ('admin')
ADMIN_PASSWORD=admin123

# Configuración del servidor Gunicorn
GUNICORN_WORKERS=3
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=120
